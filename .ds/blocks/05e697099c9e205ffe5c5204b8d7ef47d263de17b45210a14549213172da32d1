func (d *Dirs) ConfigFiles() []ConfigFile {
	cfgPath := func(base string) (string, string) {
		c, _ := d.kind(KindConfig)
		l, _ := d.kind(KindConfigLocal)
		return filepath.Join(base, filepath.FromSlash(c.Path)), filepath.Join(base, filepath.FromSlash(l.Path))
	}
	var out []ConfigFile
	add := func(base string, home Scope, committable bool) {
		if base == "" {
			return
		}
		c, l := cfgPath(base)
		out = append(out,
			ConfigFile{Path: c, Home: home, Committed: committable && inGitWorkTree(base)},
			ConfigFile{Path: l, Home: home, Local: true})
	}
	if d.override {
		add(d.global.Base, ScopeGlobal, false)
		return out
	}
	if d.globalErr == nil {
		add(d.global.Base, ScopeGlobal, false)
	}
	if d.projectErr == nil {
		add(d.project.Marker, ScopeProject, true)
		if d.targetConfig != "" {
			add(d.targetConfig, ScopeProject, true)
		}
		// A non-release profile may keep its own machine settings in
		// .<app>/profiles/<profile>/config.local.jsonc: gitignored with the
		// rest of profiles/, read last so it wins over both shared files
		// (owner, 2026-11-10).
		if d.profile != d.cfg.releaseProfile && d.project.Data != d.project.Base {
			_, l := cfgPath(d.project.Data)
			out = append(out, ConfigFile{Path: l, Home: ScopeProject, Local: true, Profile: d.profile})
		}
	}
	return out
}